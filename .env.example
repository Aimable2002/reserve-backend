# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Your project signs tokens with an ECC (P-256) key (asymmetric/ES256), so
# there's no shared secret to set here at all — verification happens against
# the project's public JWKS endpoint. Leave this blank to use the default
# (https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json); only set
# it if you're pointing at a non-default location (e.g. self-hosted).
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Flutterwave v4 ---
FLW_CLIENT_ID=your-client-id
FLW_CLIENT_SECRET=your-client-secret
FLW_ENV=sandbox
# sandbox base: https://developersandbox-api.flutterwave.com
# live base:    https://api.flutterwave.com  (confirm current live host in the Flutterwave dashboard before going live)
FLW_API_BASE_SANDBOX=https://developersandbox-api.flutterwave.com
FLW_API_BASE_LIVE=https://api.flutterwave.com
FLW_TOKEN_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
FLW_WEBHOOK_SECRET_HASH=your-dashboard-configured-secret-hash

# --- App ---
FLASK_ENV=production
PORT=8080
DEFAULT_CURRENCY=NGN
# Comma-separated origins allowed to call this API from the browser (Lovable preview + prod domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173
